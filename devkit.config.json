{
    "type": "db-orm",
    "package": "drizzle",
    "providers": {
        "neon": {
            "client": "./providers/neon/neon-drizzle.ts",
            "dependencies": ["@neondatabase/serverless"],
            "devDependencies": []
        }
    },
    "engines": {
        "pg": {
            "config": "./engines/pg/pg-drizzle.config.ts",
            "client": "./engines/pg/pg-drizzle.ts",
            "schema": "./engines/pg/pg-schema.ts",
            "dependencies": ["pg"],
            "devDependencies": ["@types/pg"]
        },
        "mysql": {
            "config": "./engines/mysql/mysql-drizzle.config.ts",
            "client": "./engines/mysql/mysql-drizzle.ts",
            "schema": "./engines/mysql/mysql-schema.ts",
            "dependencies": ["mysql2"],
            "devDependencies": []
        }
    },
    "dependencies": [
        "drizzle-orm",
        "dotenv"
    ],
    "devDependencies": [
        "drizzle-kit",
        "tsx"
    ],
    "envVars": [
        "DATABASE_URL"
    ],
    "structure": {
        "config": "drizzle.config.ts",
        "client": "drizzle.ts",
        "schema": "schema.ts"
    }
}